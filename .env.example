# --- Supabase ---
# Project URL, ej: https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Anon / public key (segura para el cliente, respeta RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SOLO del lado servidor. NUNCA la expongas al cliente.
# Se usa en los Route Handlers para crear operaciones y cambiar estados.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto que manda el worker a /api/revalidar y /api/recordatorios
# (header x-revalidar-token). El MISMO valor que REVALIDAR_TOKEN en el
# worker, mínimo 32 caracteres: `openssl rand -hex 32`. Mientras falte se
# acepta la service role key (transición); configurarlo la deja de aceptar.
REVALIDAR_TOKEN=

# --- App ---
# URL pública del sitio: links de las operaciones y los que van en los
# WhatsApp y emails de avisos (al pedido en el panel, a Mis pedidos).
# En local podés dejarlo vacío: se deriva del host de la request.
# En producción (Vercel), ej: https://tickermirror.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Tienda (TicketMirror) ---
# Número de WhatsApp para reservas/consultas, con código de país. Ej: 5491122334455
NEXT_PUBLIC_WHATSAPP=

# Los precios de la tienda se muestran en USD. La cotización EUR->USD se
# edita desde el panel (Entradas -> Precios del portal), no por env.

# --- Avisos ---
# Al equipo: cada pedido, consulta, cotización aceptada, cancelación del
# cliente, solicitud de acceso y recordatorio ("lleva rato esperando") queda en
# la campana del panel y sale por WhatsApp (y los de pedido/acceso también por
# email). Al cliente: Confirmado, Para pagar y Entregada quedan en su campana
# y, con email configurado, le llega un mail en su idioma.
# Todo es best-effort: si a un canal le faltan sus envs, ese aviso se omite y
# el registro igual se crea. Cómo salió cada WhatsApp se ve en la campana.
# Requiere las migraciones 0044 y 0045.

# WhatsApp Business (Meta Cloud API)
# Token de acceso de la app de WhatsApp Business (Meta).
WHATSAPP_TOKEN=
# ID del número emisor (Phone Number ID de la Cloud API).
WHATSAPP_PHONE_ID=
# A quién: a cada persona del equipo que tenga "Avisos por WhatsApp" activado
# en Panel → Equipo, a su teléfono de "Mi cuenta". Si la operación tiene un
# vendedor que nombra a alguien del equipo, solo a esa persona.
# WHATSAPP_VENDEDORES es la lista FIJA de respaldo: se usa solo mientras nadie
# del equipo lo tenga activado. Formato internacional sin +, separados por
# coma. Ej: 5491136148053,5492944806666
WHATSAPP_VENDEDORES=
# Opcional: versión de la Graph API (default v21.0).
WHATSAPP_GRAPH_VERSION=
# Nombre de la plantilla aprobada para el aviso de pedido nuevo (ej:
# nuevo_pedido). SIN esto se manda texto libre, que Meta sólo acepta dentro de
# las 24 h posteriores a que el vendedor le escriba al número: fuera de esa
# ventana el aviso se rechaza (error 131047). Con la plantilla, sale siempre.
# Las variables van con NOMBRE (Meta pasó a parámetros nombrados) y tienen que
# llamarse exactamente así en WhatsApp Manager:
#   {{pedido}}  "un pedido" / "una consulta" / "un pedido con consultas"
#   {{cliente}} {{entrada}} {{detalle}} {{total}}
WHATSAPP_TEMPLATE=
# Plantilla del aviso de solicitud de acceso nueva (ej: nuevo_acceso), con las
# variables {{nombre}} {{email}} {{telefono}} {{legajo}}.
WHATSAPP_TEMPLATE_ACCESO=
# Idioma de la plantilla de pedidos, TAL COMO figura en WhatsApp Manager
# (default es_AR). El idioma es parte de la identidad de la plantilla: pedir
# "es_AR" cuando se creó en "es" devuelve "template not found".
WHATSAPP_TEMPLATE_LANG=
# Idioma de la plantilla de acceso, si quedó creada en OTRO idioma que la de
# pedidos. Si se deja vacío, usa el de arriba.
WHATSAPP_TEMPLATE_ACCESO_LANG=
# Plantilla de los demás avisos al equipo (cliente aceptó o canceló,
# recordatorios), ej: aviso_operacion, categoría Utility, con las variables
# {{aviso}} (qué pasó, una línea) y {{detalle}} (detalle + link al pedido).
# SIN esto esos avisos salen como texto libre, que Meta solo entrega dentro de
# la ventana de 24 h (ver WHATSAPP_TEMPLATE).
WHATSAPP_TEMPLATE_AVISO=
# Idioma de esa plantilla, si es distinto del de la de pedidos.
WHATSAPP_TEMPLATE_AVISO_LANG=
# Opcional: 1 si las plantillas se crearon con variables NUMERADAS ({{1}} {{2}})
# en vez de con nombre. Por defecto se mandan con nombre.
WHATSAPP_TEMPLATE_NUMERICO=

# Email (Resend) — reusa el proveedor del envío de credenciales.
# Con estas dos, además, al CLIENTE le llegan los emails de Confirmado, Para
# pagar y Entregada (en el idioma en que hizo el pedido). Sin ellas, esos
# avisos quedan solo en su campana; la tarjeta del pedido en el panel dice si
# el email salió.
# API key de Resend.
RESEND_API_KEY=
# Remitente verificado en Resend. Ej: "Passion Entradas <avisos@tu-dominio.com>"
EMAIL_FROM=
# Emails de los vendedores a avisar de pedidos y accesos, separados por coma.
EMAIL_VENDEDORES=
